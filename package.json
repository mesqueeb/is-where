{
  "name": "is-where",
  "version": "2.0.6",
  "description": "JS environment check functions like `isWebkit() isSafari() isBrowser() isNode()` etc. A simple & small integration.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint ./src",
    "build": "del-cli dist && tsc",
    "release": "pnpm run lint && pnpm run build && pnpm test && bumpp --no-push --all && pnpm publish --no-git-checks && npx jsr publish && git push --follow-tags && gh release create $(git describe --tags --abbrev=0) --generate-notes --notes \"$(git log --pretty='- %s  %h' $(git describe --tags --abbrev=0 HEAD~1 2>/dev/null || git rev-list --max-parents=0 HEAD)..HEAD~1)\""
  },
  "devDependencies": {
    "@cycraft/eslint": "^0.4.7",
    "@cycraft/tsconfig": "^0.1.2",
    "@types/node": "^22.20.3",
    "bumpp": "^12.3.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.20.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "javascript",
    "typescript",
    "envchecker",
    "check-environment",
    "check-browser",
    "is-browser",
    "is-node",
    "is-deno",
    "is-safari",
    "is-chrome",
    "is-webkit",
    "is-edge",
    "is-firefox",
    "is-opera",
    "is-ie",
    "is-ssr",
    "is-server",
    "browser-checking",
    "browser-checker",
    "browser-check",
    "environment-checking",
    "environment-checker",
    "environment-check"
  ],
  "author": "Luca Ban - Mesqueeb (https://cycraft.co)",
  "funding": "https://github.com/sponsors/mesqueeb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mesqueeb/is-where.git"
  },
  "homepage": "https://github.com/mesqueeb/is-where#readme",
  "bugs": "https://github.com/mesqueeb/is-where/issues",
  "packageManager": "pnpm@11.27.0"
}
